#!/usr/bin/env bash
# Control an Eversolo DMP-A6 (and likely other Eversolo / Zidoo-platform
# players) over its unauthenticated LAN HTTP API on port 9529, plus library
# access via its SMB share.
#
# Configure target via env (with sensible defaults):
#   EVERSOLO            host or IP (auto-discover with: avahi-browse -rt _eversolo._tcp)
#   EVERSOLO_PORT       default 9529
#   EVERSOLO_SHARE      default Share
#   EVERSOLO_MUSIC_REL  e.g. 7DEF-F569/Music   (volume UUID + Music subdir)
#   EVERSOLO_INDEX      default ~/.cache/eversolo-library.tsv

set -euo pipefail
HOST="${EVERSOLO:?set EVERSOLO=<ip-or-host> (try: avahi-browse -rt _eversolo._tcp)}"
PORT="${EVERSOLO_PORT:-9529}"
BASE="http://${HOST}:${PORT}"

SHARE="${EVERSOLO_SHARE:-Share}"
MUSIC_REL="${EVERSOLO_MUSIC_REL:-}"   # required for index/search/playlist

GVFS_MNT="/run/user/$(id -u)/gvfs/smb-share:server=${HOST},share=$(echo "$SHARE" | tr '[:upper:]' '[:lower:]')"
INDEX="${EVERSOLO_INDEX:-$HOME/.cache/eversolo-library.tsv}"

req() { curl -sS -m 6 "$BASE$1"; echo; }

ensure_music_rel() {
  if [ -z "$MUSIC_REL" ]; then
    echo "EVERSOLO_MUSIC_REL not set; need <volume-uuid>/Music." >&2
    if [ -d "$GVFS_MNT" ]; then
      echo "Volumes visible on the share:" >&2
      ls -1 "$GVFS_MNT" | sed 's/^/  /' >&2
      echo "Set e.g.  EVERSOLO_MUSIC_REL=7DEF-F569/Music" >&2
    else
      echo "Mount the share first:  gio mount smb://$HOST/$SHARE/" >&2
    fi
    exit 1
  fi
}
ensure_mount() {
  ensure_music_rel
  if [ ! -d "$GVFS_MNT/$MUSIC_REL" ]; then
    echo "Library not mounted at $GVFS_MNT/$MUSIC_REL" >&2
    echo "Run:  gio mount smb://${HOST}/${SHARE}/" >&2
    return 1
  fi
}

cmd_index() {
  ensure_mount || exit 1
  mkdir -p "$(dirname "$INDEX")"
  local root="$GVFS_MNT/$MUSIC_REL"
  echo "Indexing $root  (this can take ~1-2 min over Wi-Fi)..." >&2
  find "$root" -type f \( \
       -iname "*.flac" -o -iname "*.mp3"  -o -iname "*.m4a" \
    -o -iname "*.wav"  -o -iname "*.aiff" -o -iname "*.aif" \
    -o -iname "*.dsf"  -o -iname "*.dff"  -o -iname "*.ogg" -o -iname "*.alac" \
    \) -printf '%P\n' 2>/dev/null \
  | LC_ALL=C sort \
  | awk -F/ -v OFS='\t' '
      {
        rel = $0
        file = $NF
        name = file; sub(/\.[^.]*$/, "", name)
        album  = (NF >= 2 ? $(NF-1) : "")
        artist = (NF >= 3 ? $(NF-2) : (NF >= 2 ? $(NF-1) : ""))
        print rel, artist, album, name
      }' > "$INDEX.tmp"
  mv "$INDEX.tmp" "$INDEX"
  echo "Indexed $(wc -l < "$INDEX") tracks → $INDEX" >&2
}

ensure_index() {
  if [ ! -s "$INDEX" ]; then
    cmd_index
  fi
}

# AND-match across all query terms (case-insensitive)
filter_terms() {
  local out="cat"
  for t in "$@"; do
    out="$out | grep -iF -- $(printf %q "$t")"
  done
  eval "$out"
}

cmd_search() {
  ensure_index
  if [ $# -eq 0 ]; then
    echo "usage: $0 search <query terms...>" >&2; exit 2
  fi
  filter_terms "$@" < "$INDEX" \
    | awk -F'\t' '{ printf "%-30s  %-40s  %s\n", $2, $3, $4 }'
}

cmd_playlist() {
  ensure_index
  ensure_music_rel
  local out="-"
  local args=()
  while [ $# -gt 0 ]; do
    case "$1" in
      -o) out="$2"; shift 2 ;;
      --) shift; args+=("$@"); break ;;
      *)  args+=("$1"); shift ;;
    esac
  done
  if [ ${#args[@]} -eq 0 ]; then
    echo "usage: $0 playlist [-o FILE.m3u8] <query terms...>" >&2; exit 2
  fi

  local rows
  rows=$(filter_terms "${args[@]}" < "$INDEX") || true
  if [ -z "$rows" ]; then
    echo "no matches for: ${args[*]}" >&2; exit 1
  fi

  local SMB_URI_BASE="smb://${HOST}/${SHARE}/${MUSIC_REL}"
  {
    printf '#EXTM3U\n'
    while IFS=$'\t' read -r rel artist album name; do
      [ -z "$rel" ] && continue
      printf '#EXTINF:-1,%s - %s\n' "$artist" "$name"
      local enc
      enc=$(python3 -c 'import sys,urllib.parse; print("/".join(urllib.parse.quote(p) for p in sys.argv[1].split("/")))' "$rel")
      printf '%s/%s\n' "$SMB_URI_BASE" "$enc"
    done <<< "$rows"
  } > "${out/#-/\/dev\/stdout}"

  if [ "$out" != "-" ]; then
    echo "wrote $(grep -c '^smb://' "$out") tracks → $out" >&2
  fi
}

case "${1:-help}" in
  status|state)   req "/ZidooMusicControl/v2/getState" ;;
  device|info)    req "/ZidooControlCenter/getModel" ;;
  queue)          req "/ZidooMusicControl/v2/getPlayQueue?start=0&count=${2:-20}" ;;
  volume)
    if [[ -n "${2:-}" ]]; then
      case "$2" in
        up)   req "/ZidooMusicControl/v2/setVolume?volume=up" ;;
        down) req "/ZidooMusicControl/v2/setVolume?volume=down" ;;
        mute) req "/ZidooMusicControl/v2/setVolume?volume=mute" ;;
        *)    req "/ZidooMusicControl/v2/setVolume?volume=$2" ;;   # 0..200
      esac
    else
      req "/ZidooMusicControl/v2/getVolume"
    fi ;;
  play|pause|toggle) req "/ZidooMusicControl/v2/playOrPause" ;;
  next)              req "/ZidooMusicControl/v2/playNext" ;;
  prev|previous)     req "/ZidooMusicControl/v2/playLast" ;;
  seek)              req "/ZidooMusicControl/v2/seekTo?time=${2:?ms required}" ;;
  raw)               req "$2" ;;

  index)             cmd_index ;;
  search)            shift; cmd_search "$@" ;;
  playlist)          shift; cmd_playlist "$@" ;;

  *)
    cat <<EOF
Eversolo control ($BASE)

Transport (HTTP API on port 9529, no auth on LAN):
  $0 status              # current track, position, volume, output
  $0 device              # model, firmware, MAC, capabilities
  $0 queue [N]           # current play queue (default 20)
  $0 volume              # show volume
  $0 volume <0-200|up|down|mute>      # range 0..200, NOT 0..100
  $0 play | pause | toggle    # all three toggle (single endpoint)
  $0 next | prev
  $0 seek <ms>           # absolute seek in milliseconds
  $0 raw <path>          # call any /<path> on the API directly

Library (via SMB share, cached at \$EVERSOLO_INDEX):
  $0 index               # (re)build the local track index
  $0 search <terms...>   # AND-match across artist/album/track
  $0 playlist [-o FILE.m3u8] <terms...>
                         # M3U with smb:// URIs (stdout if no -o)

Env:
  EVERSOLO=<host>            target device (required)
  EVERSOLO_SHARE=<name>      default 'Share'
  EVERSOLO_MUSIC_REL=<UUID>/Music   required for index/search/playlist
  EVERSOLO_INDEX=<path>      default ~/.cache/eversolo-library.tsv

First-time mount:
  gio mount smb://\$EVERSOLO/\$EVERSOLO_SHARE/
EOF
  ;;
esac
